<?xml version="1.0" encoding="utf-8"?>
<!--
  WWJ 行车工具 · 所有组件都在包名 icu.wwj.drive 之下。
  功能划分（一个功能 = 一个 Java 子包 + 独立的 Activity/Service）：
    icu.wwj.drive          首页壳：工具列表
    icu.wwj.drive.dashcam  行车记录仪（循环录像 / 水印 / 息屏值守）
    icu.wwj.drive.stitch   四视角拼接（多路素材合成）
  新增功能时：建 icu.wwj.drive.<feature> 包、声明组件、在 ToolRegistry 注册一行。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="icu.wwj.drive"
    android:versionCode="5"
    android:versionName="1.2.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />

    <!-- 记录仪：相机 / 前台服务 / 息屏唤醒 / GPS 水印 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      存储权限：别用 maxSdkVersion=29 —— 那会让 Android 11+ 直接「没声明」这些权限，
      运行时申请被系统静默拒绝（拼接读不到相册就是这么来的）。
      本应用 targetSdk=29，所以 Android 13/14 上系统仍走 READ_EXTERNAL_STORAGE 的兼容路径
      （READ_MEDIA_VIDEO 只在 targetSdk 33+ 才生效，暂时不申请，见 docs/ARCHITECTURE.md）。
      WRITE 只需要到 32：33+ 起写相册目录走 MediaStore，不再需要该权限。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- 记录仪 GL 水印 + 拼接 GL 画布 -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".DriveApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- 首页：工具列表 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================= 行车记录仪：icu.wwj.drive.dashcam ================= -->
        <activity
            android:name=".dashcam.DashcamActivity"
            android:exported="true"
            android:label="@string/tool_dashcam_title"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".dashcam.ClipsActivity"
            android:exported="false"
            android:label="@string/dashcam_clips_title"
            android:screenOrientation="sensorLandscape" />

        <service
            android:name=".dashcam.RecordService"
            android:exported="true" />

        <receiver
            android:name=".dashcam.WatchdogReceiver"
            android:exported="false" />

        <!-- 录像的 content:// 出口，供播放/分享时临时授权 -->
        <provider
            android:name=".dashcam.ClipProvider"
            android:authorities="icu.wwj.drive.dashcam.clips"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- ================= 四视角拼接：icu.wwj.drive.stitch ================= -->
        <activity
            android:name=".stitch.StitchHomeActivity"
            android:exported="true"
            android:label="@string/tool_stitch_title"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".stitch.StitchActivity"
            android:exported="false"
            android:label="@string/tool_stitch_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- ================= 视频压缩：icu.wwj.drive.compress ================= -->
        <activity
            android:name=".compress.CompressHomeActivity"
            android:exported="true"
            android:label="@string/tool_compress_title"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".compress.CompressActivity"
            android:exported="false"
            android:label="@string/tool_compress_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />
    </application>
</manifest>
